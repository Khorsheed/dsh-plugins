{
  "name": "@khorsheed/dsh-basic",
  "description": "Family bundle 基础体验: the everyday dsh experience — message tools, session artifacts, file surfaces, readers, guards and mobile — in one install. Thin meta package: a patch carrying the members' canonical rows, npm dependencies on the members, locale card metadata — no runtime code, no client half.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "bundle"
  ],
  "dependencies": {
    "@khorsheed/dsh-ankh-guard": "workspace:*",
    "@khorsheed/dsh-capability-catalog": "workspace:*",
    "@khorsheed/dsh-capture": "workspace:*",
    "@khorsheed/dsh-client-message-tools": "workspace:*",
    "@khorsheed/dsh-client-session-title-edit": "workspace:*",
    "@khorsheed/dsh-context-guard": "workspace:*",
    "@khorsheed/dsh-context-lens": "workspace:*",
    "@khorsheed/dsh-file-preview": "workspace:*",
    "@khorsheed/dsh-inline-html-render": "workspace:*",
    "@khorsheed/dsh-local-files": "workspace:*",
    "@khorsheed/dsh-message-timeline": "workspace:*",
    "@khorsheed/dsh-mobile": "workspace:*",
    "@khorsheed/dsh-quote": "workspace:*",
    "@khorsheed/dsh-reader": "workspace:*",
    "@khorsheed/dsh-sidechat": "workspace:*",
    "@khorsheed/dsh-taskpilot": "workspace:*",
    "@khorsheed/dsh-ui-shortcuts": "workspace:*",
    "@khorsheed/dsh-whalesong": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "kind": "family",
      "members": [
        "@khorsheed/dsh-client-message-tools",
        "@khorsheed/dsh-message-timeline",
        "@khorsheed/dsh-client-session-title-edit",
        "@khorsheed/dsh-quote",
        "@khorsheed/dsh-inline-html-render",
        "@khorsheed/dsh-context-guard",
        "@khorsheed/dsh-taskpilot",
        "@khorsheed/dsh-file-preview",
        "@khorsheed/dsh-local-files",
        "@khorsheed/dsh-capability-catalog",
        "@khorsheed/dsh-mobile",
        "@khorsheed/dsh-ui-shortcuts",
        "@khorsheed/dsh-whalesong",
        "@khorsheed/dsh-ankh-guard",
        "@khorsheed/dsh-capture",
        "@khorsheed/dsh-reader",
        "@khorsheed/dsh-sidechat",
        "@khorsheed/dsh-context-lens"
      ]
    },
    "references": [
      "@khorsheed/dsh-client-message-tools",
      "@khorsheed/dsh-message-timeline",
      "@khorsheed/dsh-client-session-title-edit",
      "@khorsheed/dsh-quote",
      "@khorsheed/dsh-inline-html-render",
      "@khorsheed/dsh-context-guard",
      "@khorsheed/dsh-taskpilot",
      "@khorsheed/dsh-file-preview",
      "@khorsheed/dsh-local-files",
      "@khorsheed/dsh-capability-catalog",
      "@khorsheed/dsh-mobile",
      "@khorsheed/dsh-ui-shortcuts",
      "@khorsheed/dsh-whalesong",
      "@khorsheed/dsh-ankh-guard",
      "@khorsheed/dsh-capture",
      "@khorsheed/dsh-reader",
      "@khorsheed/dsh-sidechat",
      "@khorsheed/dsh-context-lens"
    ],
    "compat": {
      "minHost": "0.1.5-rc.1",
      "verifiedHost": "0.2.1-rc.1",
      "notes": "Pure composition: the bundle mounts the members' canonical rows and registers nothing of its own, so the floor is the members' highest (0.1.5-rc.1 — message-tools / quote / context-guard…; the rest floor lower). Individual member behaviors behind that floor are documented in each member's own dsh.compat."
    }
  }
}
