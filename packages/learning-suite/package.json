{
  "name": "@khorsheed/dsh-learning-suite",
  "description": "Mode bundle 学习模式: the dsh-learning agent preset plus the library it grants — project-organized deep reading with a close-reading coach — in one install. Thin meta package: a patch carrying the member's canonical row and the mode's preset row, an npm dependency on the member, locale card metadata — no runtime code, no client half.",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/learning-suite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "bundle"
  ],
  "dependencies": {
    "@khorsheed/dsh-library": "workspace:*",
    "@khorsheed/dsh-reader": "workspace:*",
    "@khorsheed/dsh-transcribe": "workspace:*",
    "@khorsheed/dsh-capture": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "kind": "mode",
      "mode": "dsh-learning",
      "members": [
        "@khorsheed/dsh-library",
        "@khorsheed/dsh-reader",
        "@khorsheed/dsh-transcribe",
        "@khorsheed/dsh-capture"
      ]
    },
    "references": [
      "@khorsheed/dsh-library",
      "@khorsheed/dsh-reader",
      "@khorsheed/dsh-transcribe",
      "@khorsheed/dsh-capture"
    ],
    "compat": {
      "minHost": "0.1.7-rc.1",
      "verifiedHost": "0.2.1-rc.1",
      "notes": "Pure composition: the bundle mounts the member's canonical row plus the dsh-learning preset row and registers nothing of its own, so the floor is the member's own (0.1.7-rc.1 — library; the preset row's floor is the same line). Individual member behaviors are documented in the member's own dsh.compat."
    }
  }
}
