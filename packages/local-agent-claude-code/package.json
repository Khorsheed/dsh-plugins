{
  "name": "@khorsheed/dsh-local-agent-claude-code",
  "description": "Claude Code harness for dsh-local-agent: scoped CLAUDE_CONFIG_DIR, one-shot claude -p delegation visible in the 子代理 surface, project-file session records",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "local-agent",
    "claude-code"
  ],
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/local-agent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./records": {
      "types": "./lib/types/records.d.ts",
      "default": "./lib/records.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "references": [
      "@khorsheed/dsh-bundle-local-agent"
    ],
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compat": {
      "minHost": "0.1.5-rc.1",
      "notes": "Live output uses the local-agent transient Remote and public Conversation nodes, with incremental durable recovery checkpoints; native final messages retain their existing transcript and usage semantics. End-to-end latency acceptance is tracked by the room coordinator proposal.",
      "verifiedHost": "0.1.5-rc.1"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@khorsheed/dsh-local-agent": "workspace:*",
    "@khorsheed/dsh-local-agent-tool-subagent": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.8 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.8 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-test-runtime": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-loader-smoke": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-todo": "^0.2.0-rc.1",
    "@khorsheed/dsh-local-agent": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  }
}
