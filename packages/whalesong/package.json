{
  "name": "@khorsheed/dsh-whalesong",
  "description": "Status ambience for the dsh web GUI: the sidebar whale spouts water and the favicon animates while any task runs, with completion/blocked chimes",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "whalesong",
    "status"
  ],
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/whalesong"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compat": {
      "minHost": "0.1.2-rc.1",
      "notes": "the blocked chime reads the ui-session Session status feed (`ctx.uiSession.sessionStatus` on 0.1.6-alpha.2+, with the 0.1.5 `pendingInteractions` feed adapted forward); in an assembly without that service the blocked chime degrades off silently while completion chimes keep working",
      "verifiedHost": "0.1.2-rc.1"
    }
  },
  "scripts": {
    "bundle": "tsc -b tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-loader-smoke": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1",
    "@types/node": "^26.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "LICENSE"
  ]
}
