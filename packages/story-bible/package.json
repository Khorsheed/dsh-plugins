    "foreshadowing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compat": {
      "minHost": "0.2.0-rc.2",
      "notes": "M3 adds the browser half (dsh.client, web): two page-type right-Sidebar tab kinds (story-fragments / story-reader — the 0.1.5 sidebar.right.pane.tab + sidebarRightTabs seats, present on every shipped web line) registered through ctx.slots.inject, plus two keyed tool.call.toolview rows that degrade to the host's generic rows without ui-tool. Mode visibility follows the cross-session rule (the works store is deployment-level content: no runtime switch — the install layer decides). The story Remote face (mounted by the core row since M1) is consumed through ctx.remote.$mount; a composition mounting ONLY this client half still boots and reports the missing host half in the tab instead of throwing. State writes go through the mounted ctx.fs with the CALLING SESSION's resolved MODE and session id but the boundary re-rooted at the plugin's own state dir (a read-only deployment still denies). The per-session focus map is process-lifetime — a restart means 「nothing focused」, which the pointer, the tools and the work strip answer honestly. The 在编辑器打开 door prefers the open-in-app probe's IDE (the manuscript DIRECTORY) and falls back to the official document preview; with neither it hides. 场景/物品 boards render honestly empty: the kind axis files nothing into them yet.",
      "verifiedHost": "0.2.0-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
