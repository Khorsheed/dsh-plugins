{
  "name": "@khorsheed/dsh-bundle-conversation-toolbox",
  "description": "Family bundle 会话工具箱: message-tools, message-timeline, session-title-edit, quote, inline-html-render, context-guard and taskpilot in one install. Thin meta package: a patch carrying the members' canonical rows, npm dependencies on the members, locale card metadata — no runtime code, no client half.",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/bundle-conversation-toolbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "conversation",
    "bundle"
  ],
  "dependencies": {
    "@khorsheed/dsh-client-message-tools": "workspace:*",
    "@khorsheed/dsh-client-session-title-edit": "workspace:*",
    "@khorsheed/dsh-context-guard": "workspace:*",
    "@khorsheed/dsh-inline-html-render": "workspace:*",
    "@khorsheed/dsh-message-timeline": "workspace:*",
    "@khorsheed/dsh-quote": "workspace:*",
    "@khorsheed/dsh-taskpilot": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "kind": "family",
      "members": [
        "@khorsheed/dsh-client-message-tools",
        "@khorsheed/dsh-message-timeline",
        "@khorsheed/dsh-client-session-title-edit",
        "@khorsheed/dsh-quote",
        "@khorsheed/dsh-inline-html-render",
        "@khorsheed/dsh-context-guard",
        "@khorsheed/dsh-taskpilot"
      ]
    },
    "references": [
      "@khorsheed/dsh-client-message-tools",
      "@khorsheed/dsh-message-timeline",
      "@khorsheed/dsh-client-session-title-edit",
      "@khorsheed/dsh-quote",
      "@khorsheed/dsh-inline-html-render",
      "@khorsheed/dsh-context-guard",
      "@khorsheed/dsh-taskpilot"
    ],
    "compat": {
      "minHost": "0.1.5-rc.1",
      "verifiedHost": "0.1.7-rc.2",
      "notes": "Pure composition: the bundle mounts the members' canonical rows and registers nothing of its own, so the floor is the members' highest — message-tools, quote and taskpilot floor at 0.1.5-rc.1, the rest at 0.1.2-rc.1. Member-level degraded items on the floor line (e.g. quote's side-chat route probing) are documented in each member's own dsh.compat."
    }
  }
}
