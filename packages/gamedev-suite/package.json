{
  "name": "@khorsheed/dsh-gamedev-suite",
  "description": "Mode bundle 游戏开发模式: the dsh-gamedev agent preset plus the game workbench it grants — build and play a small 2D web game with the agent — plus the multi-agent family (the local-agent core, the four delegation providers and the room), in one install. Thin meta package: a patch carrying the members' canonical rows and the mode's preset row, npm dependencies on the members, locale card metadata — no runtime code, no client half.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/gamedev-suite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "bundle"
  ],
  "dependencies": {
    "@khorsheed/dsh-game": "workspace:*",
    "@khorsheed/dsh-local-agent": "workspace:*",
    "@khorsheed/dsh-local-agent-claude-code": "workspace:*",
    "@khorsheed/dsh-local-agent-codex": "workspace:*",
    "@khorsheed/dsh-local-agent-dsh": "workspace:*",
    "@khorsheed/dsh-local-agent-dsh-headless": "workspace:*",
    "@khorsheed/dsh-local-agent-kimi": "workspace:*",
    "@khorsheed/dsh-room": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "kind": "mode",
      "mode": "dsh-gamedev",
      "members": [
        "@khorsheed/dsh-game",
        "@khorsheed/dsh-local-agent",
        "@khorsheed/dsh-local-agent-kimi",
        "@khorsheed/dsh-local-agent-codex",
        "@khorsheed/dsh-local-agent-claude-code",
        "@khorsheed/dsh-local-agent-dsh",
        "@khorsheed/dsh-room"
      ]
    },
    "references": [
      "@khorsheed/dsh-game",
      "@khorsheed/dsh-local-agent",
      "@khorsheed/dsh-local-agent-kimi",
      "@khorsheed/dsh-local-agent-codex",
      "@khorsheed/dsh-local-agent-claude-code",
      "@khorsheed/dsh-local-agent-dsh",
      "@khorsheed/dsh-room"
    ],
    "compat": {
      "minHost": "0.2.0-rc.1",
      "verifiedHost": "0.2.1-rc.1",
      "notes": "Pure composition: the bundle mounts the members' canonical rows plus the dsh-gamedev preset row and registers nothing of its own, so the floor is the members' highest (0.2.0-rc.1 — game; the local-agent family and room floor at 0.1.5-rc.1). Member behavior details live in each member's own dsh.compat."
    }
  }
}
