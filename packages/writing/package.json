{
  "name": "@khorsheed/dsh-writing",
  "description": "Mode bundle 写作模式: the dsh-writing agent preset plus the writing family it grants — the inspiration canvas and its full-length-novel genre — in one install. Thin meta package: a patch carrying the members' canonical rows and the mode's preset row, npm dependencies on the members, locale card metadata — no runtime code, no client half.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/writing"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "bundle"
  ],
  "dependencies": {
    "@khorsheed/dsh-canvas": "workspace:*",
    "@khorsheed/dsh-canvas-novel": "workspace:*",
    "@khorsheed/dsh-reader": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "kind": "mode",
      "mode": "dsh-writing",
      "members": [
        "@khorsheed/dsh-canvas",
        "@khorsheed/dsh-canvas-novel",
        "@khorsheed/dsh-reader"
      ]
    },
    "references": [
      "@khorsheed/dsh-canvas",
      "@khorsheed/dsh-canvas-novel",
      "@khorsheed/dsh-reader"
    ],
    "compat": {
      "minHost": "0.2.0-rc.2",
      "verifiedHost": "0.2.1-rc.1",
      "notes": "Pure composition: the bundle mounts the members' canonical rows plus the dsh-writing preset row and registers nothing of its own, so the floor is the members' highest (0.2.0-rc.2 — canvas-novel; canvas itself floors at 0.1.5-rc.1). Individual member behaviors are documented in each member's own dsh.compat."
    }
  }
}
