{
  "name": "@khorsheed/dsh-dev-suite",
  "description": "Mode bundle 开发模式: the dsh-dev agent preset plus the dev family it grants — the local-agent core and the kimi / codex / claude-code / dsh delegation providers, worktrees, room and typesafe, plus the developer-facing ankh-guard and context-lens — in one install. Thin meta package: a patch carrying the members' canonical rows and the mode's preset row, npm dependencies on the members, locale card metadata — no runtime code, no client half.",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/dev-suite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "bundle"
  ],
  "dependencies": {
    "@khorsheed/dsh-ankh-guard": "workspace:*",
    "@khorsheed/dsh-context-lens": "workspace:*",
    "@khorsheed/dsh-local-agent": "workspace:*",
    "@khorsheed/dsh-local-agent-claude-code": "workspace:*",
    "@khorsheed/dsh-local-agent-codex": "workspace:*",
    "@khorsheed/dsh-local-agent-dsh": "workspace:*",
    "@khorsheed/dsh-local-agent-dsh-headless": "workspace:*",
    "@khorsheed/dsh-local-agent-kimi": "workspace:*",
    "@khorsheed/dsh-room": "workspace:*",
    "@khorsheed/dsh-typesafe": "workspace:*",
    "@khorsheed/dsh-worktrees": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "kind": "mode",
      "mode": "dsh-dev",
      "members": [
        "@khorsheed/dsh-local-agent",
        "@khorsheed/dsh-local-agent-kimi",
        "@khorsheed/dsh-local-agent-codex",
        "@khorsheed/dsh-local-agent-claude-code",
        "@khorsheed/dsh-local-agent-dsh",
        "@khorsheed/dsh-worktrees",
        "@khorsheed/dsh-room",
        "@khorsheed/dsh-typesafe",
        "@khorsheed/dsh-ankh-guard",
        "@khorsheed/dsh-context-lens"
      ]
    },
    "references": [
      "@khorsheed/dsh-local-agent",
      "@khorsheed/dsh-local-agent-kimi",
      "@khorsheed/dsh-local-agent-codex",
      "@khorsheed/dsh-local-agent-claude-code",
      "@khorsheed/dsh-local-agent-dsh",
      "@khorsheed/dsh-worktrees",
      "@khorsheed/dsh-room",
      "@khorsheed/dsh-typesafe",
      "@khorsheed/dsh-ankh-guard",
      "@khorsheed/dsh-context-lens"
    ],
    "compat": {
      "minHost": "0.1.7-rc.1",
      "verifiedHost": "0.2.1-rc.1",
      "notes": "Pure composition: the bundle mounts the members' canonical rows plus the dsh-dev preset row and registers nothing of its own. The floor is the higher of the members' highest (0.1.5-rc.1 — the local-agent family, worktrees, room, typesafe, ankh-guard, context-lens) and the preset row's floor: an `@deepseek-ai/dsh-agent-preset` declaration exists only on host 0.1.7-rc.1 and later. Individual member behaviors are documented in each member's own dsh.compat."
    }
  }
}
