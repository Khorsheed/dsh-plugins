{
  "name": "@khorsheed/dsh-client-ui-file-preview",
  "description": "Session products page in the right sidebar: the files a session wrote or edited with per-change diff history; content preview delegates to the official document tab",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "file-preview"
  ],
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/ui-file-preview"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-deliverables",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compat": {
      "minHost": "0.1.5-rc.1",
      "verifiedHost": "0.1.5-rc.1",
      "notes": "双线内容面：0.1.7-rc.1 起内容预览注册进官方 documentPreviews 面（extension 档，官方 document tab 的默认渲染器，官方渲染器收进工具栏下拉；不再注册自建 FilePreviewTab tab 类型，文件点击/mentions/会话产物入口全部路由官方 document tab），0.1.5 保留自建产物页 tab（npm 最新发布线仍是 0.1.5，不断线）。改动记录维度（TurnFileRow 回合卡 + FileHistoryBody 改动记录渲染器）官方无对应物——workspace-changes 为内存态、git-only、宿主重启即失——维持我方机制并跟踪上游。rc.1 线的手势对账：复制路径/内容搜索/结构化渲染/HTML 沙箱分级随内容面板并入注册定义；在文件夹打开/在 IDE 打开让位官方 ui-open-in-app 的 document actions 贡献；图片预览让位官方缩放查看器（avif 除外，官方未认领）；超大文件改走官方渲染器的滚动分页（下拉里选官方文本渲染器）。"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "build": "tsc -p tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@khorsheed/dsh-file-preview": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-api-workspace-files": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-resources": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-test-runtime": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.7-rc.1",
    "@khorsheed/dsh-client-ui-content-preview": "workspace:*",
    "@khorsheed/dsh-file-preview": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "immer": "^10.1.1",
    "zustand": "~4.4.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": {
      "optional": true
    }
  }
}
