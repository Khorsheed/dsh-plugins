{
  "name": "@khorsheed/dsh-client-ui-file-preview",
  "description": "Session products page in the right sidebar: the files a session wrote or edited with per-change diff history; content preview delegates to the official document tab",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "file-preview"
  ],
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khorsheed/dsh-plugins.git",
    "directory": "packages/ui-file-preview"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compat": {
      "minHost": "0.1.5-rc.1",
      "verifiedHost": "0.1.5-rc.1"
    }
  },
  "scripts": {
    "bundle": "tsc -p tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "build": "tsc -p tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@khorsheed/dsh-file-preview": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-test-runtime": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "^0.1.5-rc.1",
    "@khorsheed/dsh-file-preview": "workspace:*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "immer": "^10.1.1",
    "zustand": "~4.4.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": {
      "optional": true
    }
  }
}
