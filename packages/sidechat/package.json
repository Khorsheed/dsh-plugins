    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "jsdom": "^30.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsx ../../scripts/gen-typert.mts && tsc -b tsconfig.json && tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "sidechat",
    "side-chat",
    "chat",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "compat": {
      "minHost": "0.1.5-rc.1",
      "notes": "侧边对话 is a page-type right-Sidebar tab (0.1.5's sidebar.right.pane.tab + sidebarRightTabs registry, the local-files/canvas precedent) — hosts before 0.1.5 have no right Sidebar seat, so minHost starts there. The「引用到侧边对话」message action rides the `conversation.chat.assistant-actions` list seat and the floating dock rides the frame-wide `shell.overlay` list seat (declared by ui-chat's turn-tail node and ui-layout's frame; all registrations ride ctx.slots.inject, so a host without a seat simply shows no action / no dock — the tab stays the whole surface). It is a web surface: a headless profile has no browser consumer and the plugin contributes nothing there. The host half runs each context's chat as a real agent session (ctx.agents.create/resume, the room precedent) and persists its contextKey→session mapping at $DSH_HOME/state/sidechat/contexts.json through the mounted ctx.fs with the sandbox fence RE-ROOTED at that state dir (the canvas store.ts precedent: calling session resolves the mode and lends its id, boundary is the plugin state root; a host without ctx.fs degrades to in-memory state, lost on restart). Consumer tools/systemPrompt are host-side objects passed in-process (ctx.sideChat.openWith) — they never cross the Remote wire; origin tagging of caller tools is the caller's job. The side agent mounts the deployment's default agent preset (probed agentPresets) so ordinary file tools work with the inherited cwd; without a presets roster it composes plain (chat-only).",
      "verifiedHost": "0.1.5-rc.1"
    }
  }
}
