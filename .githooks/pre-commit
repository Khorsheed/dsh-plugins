#!/bin/sh
# Repo hygiene gate: block commits that would publish absolute local paths,
# credential-shaped strings, or tooling/scratch state. Checks only the staged
# set (what this commit would publish) so it stays fast; use
# `pnpm check:hygiene --all` for a full audit of the tracked tree.
set -e

if git diff --cached --name-only --diff-filter=ACMR --quiet; then
  exit 0 # nothing staged to check
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm not found, skipping repo hygiene check" >&2
  exit 0
fi

pnpm exec tsx scripts/check-repo-hygiene.ts --staged
