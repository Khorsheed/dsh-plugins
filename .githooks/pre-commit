#!/bin/sh
# Repo hygiene + Agent Note gates: block commits that would publish absolute
# local paths, credential-shaped strings, or tooling/scratch state (staged set
# only), and keep the Agent Note tree structure, its per-note format, and the
# bilingual pairs consistent (whole tree — cheap at this repo's size; use
# `pnpm check:hygiene --all` for a full hygiene audit of the tracked tree).
# Every pnpm call passes --config.verify-deps-before-run=false so another
# agent's in-flight pnpm-lock.yaml (a deps-status mismatch) cannot turn the
# gate itself into an interactive reinstall prompt.
set -e

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm not found, skipping repo gates" >&2
  exit 0
fi

PNPM="pnpm --config.verify-deps-before-run=false"

if ! git diff --cached --name-only --diff-filter=ACMR --quiet; then
  $PNPM exec tsx scripts/check-repo-hygiene.ts --staged
fi

$PNPM exec tsx scripts/verify-agent-note-classification.ts
$PNPM exec tsx scripts/verify-agent-note-format.ts
$PNPM exec tsx scripts/verify-translation-pairing.mts
