#!/bin/sh
# Local stand-in for branch protection on main.
#
# GitHub refuses protected branches and rulesets on a private repo under a
# Free plan (both endpoints answer 403 "Upgrade to GitHub Pro or make this
# repository public"), so the two protections that matter most — no force
# push, no deletion — are enforced here instead. When the repo goes public,
# enable the real thing server-side; this hook then becomes a fast local
# echo of it rather than the only line of defence.
#
# git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
set -e

ZERO=0000000000000000000000000000000000000000
STATUS=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main) ;; *) continue ;; esac

  if [ "$local_sha" = "$ZERO" ]; then
    echo "pre-push: refusing to delete main." >&2
    STATUS=1
    continue
  fi

  # A brand-new remote branch has no history to lose.
  [ "$remote_sha" = "$ZERO" ] && continue

  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: refusing a non-fast-forward push to main." >&2
    echo "  origin/main ($(git rev-parse --short "$remote_sha")) is not an ancestor of what you are pushing." >&2
    echo "  Rebase or merge instead; rewriting shared history strands every other worktree." >&2
    STATUS=1
  fi
done

exit $STATUS
