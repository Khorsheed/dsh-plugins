node_modules/
# …and a SYMLINK named node_modules, which the trailing-slash rule above does
# not match: the worktree recipe for running `pnpm gate` links each package's
# node_modules in from the main checkout, and `git add -A` would otherwise
# commit those links — which then replace the real directories on checkout.
node_modules
lib/
*.tgz
.DS_Store
coverage/
*.log
.harness-diff/

# Stray repo-root scratch note (kept out of git; not a project file).
dsh-plugins-intro.md

# harness / dev tooling state
.playwright-mcp/
scratch-*
*.tsbuildinfo

# pnpm v11 local store created by sandboxed installs
.pnpm-store/

# dsh-lab's fingerprint mirror when a CLI run happens outside a $DSH_HOME
.dsh-lab-state/

# Debug screenshots are scratch and stay untracked; doc-referenced images in
# docs/screenshots/ and profiles/*/docs/screenshots/ are the deliberate
# exception (git add -f).
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Work-in-progress skill (integration/dsh-self-upgrade-rc1-next); kept out of the
# published tree until it is ready — the branch re-adds it on merge.
skills/self-upgrade/
